<!-- ORDER FORM -->
<div style="text-align:center; padding:30px 15px; background:#f1f5f9;">
  <h2>Order A Website / Design</h2>
  <p>Fill this form, e go send your order to David on WhatsApp</p>

  <input id="name" type="text" placeholder="Your Name" style="width:90%; padding:12px; margin:8px; border-radius:10px; border:1px solid #ccc;"><br>
  
  <select id="service" style="width:90%; padding:12px; margin:8px; border-radius:10px; border:1px solid #ccc;">
    <option>Website Design - From ₦50,000</option>
    <option>Business Logo - From ₦15,000</option>
    <option>Flyer / Poster - From ₦10,000</option>
    <option>Social Media Management</option>
  </select><br>

  <input id="details" type="text" placeholder="Tell David what you want e.g. Website for my shop" style="width:90%; padding:12px; margin:8px; border-radius:10px; border:1px solid #ccc;"><br>

  <button onclick="sendOrder()" style="background:#25D366; color:white; padding:15px 30px; border:none; border-radius:30px; font-weight:bold; font-size:17px;">Send Order on WhatsApp</button>
</div>

<script>
function sendOrder(){
  var name = document.getElementById('name').value;
  var service = document.getElementById('service').value;
  var details = document.getElementById('details').value;
  var msg = "Hello David, My name is " + name + ". I want: " + service + ". Details: " + details;
  window.open("https://wa.me/2349015266846?text=" + encodeURIComponent(msg));
}
</script>
